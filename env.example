# Copy this file to .env.local and fill in real values — .env.local is
# gitignored, so secrets here never get committed. Restart `npm run dev`
# after changing any of these.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, further down — keep this one out of any client code. It
# bypasses Row Level Security entirely, so it must never reach the
# browser. Only used server-side, in app/api/forgot-username/route.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only needed for "forgot username" to actually send an email —
# resend.com has a free tier. Without this, that flow still works (same
# response either way) but doesn't send anything.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# The USDA ingredient database (data/usda/foods.db, ~1GB with Branded Foods
# included) is too large to commit to git or bundle into the deployment.
# It lives in a Cloudflare R2 bucket instead; this is that object's public
# read URL (a plain HTTPS URL, no credentials needed) — the app downloads
# it once per cold start and caches it in /tmp. Not needed locally if
# data/usda/foods.db already exists on disk (see scripts/import-usda.mjs).
USDA_DB_URL=

# Only needed to run scripts/upload-usda-db.mjs locally after rebuilding
# foods.db — never needed by the deployed app itself.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

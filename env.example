# Copy this file to .env.local and fill in real values — .env.local is
# gitignored, so secrets here never get committed. Restart `npm run dev`
# after changing any of these.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, further down — keep this one out of any client code. It
# bypasses Row Level Security entirely, so it must never reach the
# browser. Only used server-side, in app/api/forgot-username/route.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only needed for "forgot username" to actually send an email —
# resend.com has a free tier. Without this, that flow still works (same
# response either way) but doesn't send anything.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# The USDA ingredient database (foods + Branded Foods, ~1.9M rows) is too
# large to commit to git or bundle into the deployment (Vercel's /tmp cap
# is 500MB; the built file is ~1GB). It lives in Cloudflare D1 instead —
# every ingredient lookup is a real HTTP call (see lib/usda/d1.ts), so
# these ARE needed in production, unlike a typical "local build secret".
# Cloudflare dashboard -> profile icon -> My Profile -> API Tokens (needs
# Account / D1 / Edit permission) for the token; the account id is in the
# dashboard URL or any R2/D1 resource's overview page.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=

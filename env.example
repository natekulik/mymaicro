# Copy this file to .env.local and fill in real values — .env.local is
# gitignored, so secrets here never get committed. Restart `npm run dev`
# after changing any of these.

# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same page, further down — keep this one out of any client code. It
# bypasses Row Level Security entirely, so it must never reach the
# browser. Only used server-side, in app/api/forgot-username/route.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, only needed for "forgot username" to actually send an email —
# resend.com has a free tier. Without this, that flow still works (same
# response either way) but doesn't send anything.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
